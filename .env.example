# Frontend: URL of the WebSocket comms relay (baked into the Next.js build)
NEXT_PUBLIC_COMM_WS_URL=ws://localhost:8001

# Frontend: URL of the FastAPI decision backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend API (FastAPI / uvicorn)
API_HOST=0.0.0.0
API_PORT=8000

# Backend database (Prisma / PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/railsahayak
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/railsahayak_test

